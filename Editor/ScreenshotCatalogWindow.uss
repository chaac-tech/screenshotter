.screenshot-catalog-root {
    flex-grow: 1;
}

.screenshot-catalog-top-bar {
    padding-top: 7px;
    padding-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(128, 128, 128, 0.35);
    background-color: rgba(128, 128, 128, 0.035);
}

.screenshot-catalog-body {
    flex-direction: row;
}

.screenshot-catalog-navigator {
    min-width: 220px;
    border-right-width: 1px;
    border-right-color: rgba(128, 128, 128, 0.55);
    background-color: rgba(0, 0, 0, 0.035);
}

.screenshot-catalog-navigator--narrow {
    min-width: 0;
    border-right-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(128, 128, 128, 0.35);
}

.screenshot-catalog-workspace {
    min-width: 0;
}

.screenshot-catalog-navigator-contents {
    padding: 4px 6px 10px 6px;
}

.screenshot-catalog-navigator-toolbar {
    padding: 4px 5px 4px 5px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(128, 128, 128, 0.22);
}

.screenshot-catalog-category-header {
    flex-direction: row;
    align-items: center;
    margin-top: 7px;
    margin-bottom: 3px;
    padding-left: 4px;
    padding-right: 4px;
}

.screenshot-catalog-category-name {
    flex-grow: 1;
    -unity-font-style: bold;
    font-size: 11px;
}

.screenshot-catalog-category-count {
    opacity: 0.65;
    font-size: 10px;
}

.screenshot-catalog-slot-row {
    min-height: 30px;
    flex-direction: row;
    align-items: center;
    margin-bottom: 1px;
    padding-left: 8px;
    padding-right: 6px;
    background-color: rgba(128, 128, 128, 0.07);
}

.screenshot-catalog-slot-row:hover {
    background-color: rgba(90, 145, 205, 0.22);
}

.screenshot-catalog-slot-row--selected {
    background-color: rgba(42, 104, 170, 0.82);
}

.screenshot-catalog-slot-name {
    flex-grow: 1;
    overflow: hidden;
    white-space: nowrap;
    -unity-text-overflow-position: end;
}

.screenshot-catalog-slot-row--selected .screenshot-catalog-slot-name {
    -unity-font-style: bold;
    color: rgb(235, 245, 255);
}

.screenshot-catalog-slot-armed {
    width: 39px;
    margin-right: 3px;
    padding-top: 2px;
    padding-bottom: 2px;
    border-radius: 2px;
    background-color: rgba(70, 140, 215, 0.28);
    color: rgb(135, 190, 250);
    font-size: 8px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.screenshot-catalog-slot-status {
    width: 69px;
    font-size: 9px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

.screenshot-catalog-empty-message {
    margin: 9px;
    white-space: normal;
    opacity: 0.75;
}

.screenshot-catalog-workspace-contents {
    padding: 12px 14px 18px 14px;
}

.screenshot-catalog-status-bar {
    padding: 4px 7px;
    border-top-width: 1px;
    border-top-color: rgba(128, 128, 128, 0.5);
    background-color: rgba(0, 0, 0, 0.08);
}
